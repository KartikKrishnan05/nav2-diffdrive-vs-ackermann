Panels:
  - Class: rviz/Displays
    Name: Displays
    Property:
      Displays:
        - Class: rviz/Grid
          Name: Grid
          Enabled: true
          Cell Size: 1.0
          Line Width: 0.03
          Color: 0.9 0.9 0.9 1.0
          Alpha: 0.5
          Fixed Frame: world
          Line Style: Lines
          Plane: XY
        - Class: rviz/RobotModel
          Name: RobotModel
          Enabled: true
          Robot Description: robot_description
          Fixed Frame: world
          Alpha: 1.0
          Update Interval: 0.1
        - Class: rviz/TF
          Name: TF
          Enabled: true
          Fixed Frame: world
